{
  "name": "rn-arch-check",
  "version": "0.1.1",
  "description": "Scan a React Native project's dependencies and report New Architecture (Fabric, TurboModules, JSI) compatibility",
  "type": "module",
  "bin": {
    "rn-arch-check": "bin/cli.js"
  },
  "main": "lib/scanner.js",
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishalibrar/rn-arch-check.git"
  },
  "homepage": "https://github.com/mishalibrar/rn-arch-check#readme",
  "bugs": {
    "url": "https://github.com/mishalibrar/rn-arch-check/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node --test test/*.test.js"
  },
  "keywords": [
    "react-native",
    "new-architecture",
    "fabric",
    "turbomodules",
    "jsi",
    "expo",
    "cli",
    "dependencies"
  ],
  "author": "mishalibrar <mishalibrar12@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  }
}
